# Verzeichnis auf dem Host für Datenbank, Instanz-Volumes und Backups.
# Muss ein absoluter Pfad sein — der Docker-Daemon löst die Bind-Mounts der
# Instanzen aus seiner eigenen Sicht auf.
GSP_DATA_DIR=/srv/gameserver

# `GSP_VOLUME_DIR` bewusst nicht hier: Der Host-Pfad der Bind-Mounts entsteht
# starr als `GSP_HOST_DATA_DIR/instances` und zieht ein abweichendes
# `GSP_VOLUME_DIR` nicht mit. Wer die Volumes verlegt, bekommt Mounts, die auf
# dem Host danebenzeigen — und zwar lautlos.
#
# Auf einem Unraid-NAS lässt sich allein `GSP_DB_PATH` gefahrlos herauslösen,
# um die Datenbank auf den Cache-Pool zu legen. Siehe README, Abschnitt Unraid.

# Host oder Domain, unter der die Gameserver erreichbar sind. Erscheint als
# Verbindungsadresse im Panel und wird für Ping und Spielerabfrage benutzt.
GSP_PUBLIC_HOST=spiele.example.org

# Beschriftung in der Kopfzeile.
GSP_NODE_LABEL=node 01

# Auf true setzen, sobald das Panel hinter TLS erreichbar ist.
GSP_SECURE_COOKIES=false

# Optional: Schlüssel für den KI-gestützten Vorlagenentwurf. Ohne ihn bleibt der
# Knopf „Vorlage entwerfen lassen" ausgeblendet. Bewusst hier und nicht in der
# Datenbank — dort läge er in jedem Backup.
#
# Kostenlos und ohne Kreditkarte: https://aistudio.google.com/apikey
# GSP_GEMINI_API_KEY=

# Modell für den Entwurf. Nur nötig, wenn die Vorgabe nicht mehr verfügbar ist —
# Googles Kennungen ändern sich schneller als dieses Panel.
# GSP_GEMINI_MODELL=gemini-3.7-flash
