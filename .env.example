# Verzeichnis auf dem Host für Datenbank, Instanz-Volumes und Backups.
# Muss ein absoluter Pfad sein — der Docker-Daemon löst die Bind-Mounts der
# Instanzen aus seiner eigenen Sicht auf.
GSP_DATA_DIR=/srv/gameserver

# Host oder Domain, unter der die Gameserver erreichbar sind. Erscheint als
# Verbindungsadresse im Panel und wird für Ping und Spielerabfrage benutzt.
GSP_PUBLIC_HOST=spiele.example.org

# Beschriftung in der Kopfzeile.
GSP_NODE_LABEL=node 01

# Auf true setzen, sobald das Panel hinter TLS erreichbar ist.
GSP_SECURE_COOKIES=false
